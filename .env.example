# Bu dosyayı `.env` olarak kopyala ve değerleri doldur.
# .env dosyası .gitignore'da — anahtarını asla depoya gönderme.

# Google AI Studio anahtarı: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Kullanılacak model. Hız/maliyet için flash, daha iyi metin için pro.
GEMINI_MODEL=gemini-3.6-flash

# true iken Gemini'ye HİÇ istek atılmaz, sabit bir örnek CV döner.
# Arayüzü/PDF'i geliştirirken kotayı yakmamak için kullan.
MOCK_LLM=false

# Not: Windows'ta 3000 bazen Hyper-V tarafından rezerve edilir; o durumda değiştir.
PORT=8787
